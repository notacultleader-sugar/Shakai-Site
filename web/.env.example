# Copy to .env.local for local work. Leave everything blank to run in demo mode
# (sample data, a tier switcher, no real sign in or payments).

# Your public site address, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys, and the webhook's signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mux > Settings > Signing keys (the private key is the base64 text Mux gives you)
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
